# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Use a password without URL-special characters (@ : / ? # %), because it is
# placed inside the postgres:// connection URL.

POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketplace_dev

# Host ports. 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8081
# The browser E2E API (compose profile "e2e", database marketplace_e2e).
# API_E2E_HOST_PORT=8082

# API settings (all optional; defaults shown).
APP_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173
# How long a login stays valid (Go duration: 30m, 24h, ...).
SESSION_TTL=24h

# ---- Optional tuning (not forwarded by docker-compose.yml unless you add them there) ----
# REQUEST_TIMEOUT=10s
# SHUTDOWN_TIMEOUT=15s
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_CHECK_PERIOD=1m
# DB_CONNECT_TIMEOUT=5s
# Brute-force limits (production values). Only the api-e2e container raises them.
# RATE_LIMIT_LOGIN_FAILURES=5
# RATE_LIMIT_LOGIN_WINDOW=15m
# RATE_LIMIT_REGISTRATIONS=10
# RATE_LIMIT_REGISTER_WINDOW=1h
