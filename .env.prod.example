# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-
# ignored) and pass it explicitly, so the dev .env is never used by mistake:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Generate the password, e.g.: openssl rand -hex 24
# (no URL-special characters: it goes inside the postgres:// URL).

POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
POSTGRES_DB=marketplace

# The address people type in the browser, scheme + host (+ port if not 443).
PUBLIC_ORIGIN=https://shop.example.com

# Where nginx is published. Default 127.0.0.1:8080: only this machine (or a
# TLS terminator on it) can reach it. 0.0.0.0 exposes plain HTTP to the network.
WEB_BIND=127.0.0.1
WEB_HOST_PORT=8080

LOG_LEVEL=info
SESSION_TTL=24h
