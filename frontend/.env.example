# Copy to .env.local if you need to override. Everything VITE_* is bundled
# into the browser code, so never put secrets here.

# Leave empty in development: requests go to the Vite dev server, which
# proxies /api, /health and /ready to the Go API (see vite.config.ts).
# Set it only when the frontend is served from a different origin than the API,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
